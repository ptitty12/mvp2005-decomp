# /etc/mvp/server.env (mode 0640, root:mvp). Secrets live in their own files
# (mode 0640, root:mvp), never in the repository.
MVP_SERVER_CONFIG=/etc/mvp/server.json
MVP_TURN_SECRET_FILE=/etc/mvp/turn-secret
# The key of the player link https://<domain>/?key=<key> (made once by
# install.sh): a browser that opened it may play with the server's disc. The site
# itself is open to anyone; there is no password.
MVP_ACCESS_KEY_FILE=/etc/mvp/access-key
# The key of the admin link https://<domain>/?admin=<key> (made once by install.sh):
# the Server disc page and the save states (optional; without it they are off).
MVP_ADMIN_KEY_FILE=/etc/mvp/admin-key
