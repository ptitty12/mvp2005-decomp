# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py   text

# Enforce platform-specific encodings
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.sh   text eol=lf
*.sha1 text eol=lf

# decomp-toolkit writes files with LF
config/**/*.txt  text eol=lf
# The engine's pinned copy of them: byte for byte, its SHA-256 is checked (engine/decomp_pin/README.md)
engine/decomp_pin/*.txt  text eol=lf

# dtk config: merge by meaning, not line position (tools/swarm/merge_dtk.py;
# drivers registered by tools/swarm/install_merge_drivers.py)
config/GV4E69/symbols.txt merge=dtk-symbols
config/GV4E69/splits.txt  merge=dtk-splits

# Append-only logs: keep both sides of parallel appends
PROGRESS.md       merge=union
docs/SPEEDUPS.md  merge=union
docs/PATTERNS.md  merge=union

# Patches must keep their exact bytes (a CRLF checkout breaks git apply)
*.patch -text
docs/DECISIONS.md merge=union
PROGRESS.md merge=union
